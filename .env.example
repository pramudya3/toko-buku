APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
# Untuk 1000 concurrent baca (VPS 2GB) via PgBouncer: DB_PORT=6439 (lihat deploy/pgbouncer.ini)
# DB_PORT=6439
DB_DATABASE=toko_buku
DB_USERNAME=toko_buku
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
# Wajib true di produksi HTTPS (cookie session hanya lewat HTTPS)
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# Untuk 1000 concurrent: redis menghemat 2GB dibanding file/database
# CACHE_STORE=redis
# CACHE_PREFIX=toko_buku

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=brevo
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="admin@miniapps.id"
MAIL_FROM_NAME="${APP_NAME}"

# ── Brevo (API) — untuk reset password & notifikasi email ──
# Dapatkan di https://app.brevo.com/settings/keys/api
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

APP_TIMEZONE=Asia/Jakarta
DB_TIMEZONE=Asia/Jakarta

API_CO_ID_KEY=
API_CO_ORIGIN_VILLAGE=

BITESHIP_API_KEY=
BITESHIP_ORIGIN_POSTAL_CODE=

# ── RajaOngkir (Komerce) — cek ongkir ──
RAJAONGKIR_API_KEY=
RAJAONGKIR_BASE_URL=https://rajaongkir.komerce.id/api/v1

# ── Akun superadmin tester (SuperAdminSeeder) ──
TESTER_ADMIN_EMAIL=admin@tokobuku.test
TESTER_ADMIN_PASSWORD=password
TESTER_ADMIN_NAME="Super Admin"

# ── R2 (Cloudflare) — opsional, untuk migrasi dari storage R2 lama ──
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=toko-buku
# R2_URL=
# R2_ACCOUNT_ID=
# R2_ENDPOINT=
# R2_USE_PATH_STYLE_ENDPOINT=true
# ── Google OAuth (Socialite) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

TRUSTED_PROXIES=*

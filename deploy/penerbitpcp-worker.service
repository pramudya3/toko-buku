[Unit]
Description=Laravel Queue Worker - penerbitpcp.com
After=network.target redis-server.service pgbouncer.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/var/www/toko-buku-vue
ExecStart=/usr/local/bin/frankenphp php-cli artisan queue:work --sleep=3 --tries=3 --max-time=3600 --max-jobs=1000
Restart=always
RestartSec=5

Environment=APP_ENV=production
Environment=APP_DEBUG=false

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
